[Unit]
Description=Switch Pulse Elite and a selected fallback audio output
After=pipewire.service wireplumber.service
ConditionPathExists=%E/pulse-elite-autoswitch/config.json

[Service]
ExecStart=/usr/bin/pulse-elite-autoswitch run
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
